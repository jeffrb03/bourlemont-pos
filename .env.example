# ==============================================================
# BOURLEMONT CHAMPAGNE BAR - POS & INVENTORY ENGINE CONFIG
# ==============================================================

# Entorno de Ejecución (DEVELOPMENT / PRODUCTION)
ENVIRONMENT=DEVELOPMENT
DEBUG=True
APP_NAME="Bourlemont Champagne Bar POS"
SECRET_KEY="bourlemont-ultra-secret-key-change-in-production-sacatepequez"

# Servidor Local
HOST=127.0.0.1
PORT=8000

# Base de Datos MySQL 8.0+ (InnoDB)
# Si no hay MySQL activo localmente, el sistema usará SQLite local de contingencia:
# DATABASE_URL=sqlite:///./bourlemont.db
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/bourlemont_pos
FALLBACK_TO_SQLITE=True

# Configuración de Facturación Electrónica SAT / Infile
# Proveedores disponibles: MOCK, INFILE
FEL_PROVIDER=MOCK
FEL_NIT_EMITTER=98765432-1
FEL_USER_PREFIX_WS=BOURLEMONT_POS_WS
FEL_KEY_WS=4B8F3D7A2C1E9087654321FEEDFACE00
FEL_PREFIX_UNIQUE_IDENTIFIER=BLM

# Políticas de Bar
ALLOW_NEGATIVE_STOCK=True
DEFAULT_TAX_RATE=0.12
DEFAULT_CURRENCY=GTQ
CURRENCY_SYMBOL="Q"
